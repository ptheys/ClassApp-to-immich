# Immich
IMMICH_BASE_URL=https://immich.example.com/api
IMMICH_API_KEY=changeme
IMMICH_TAG_PREFIX=ClassApp

# ClassApp (login é feito manualmente via noVNC; client_id/token são
# capturados automaticamente durante o login e salvos em /data/session.json)
CLASSAPP_BASE_URL=https://classapp.com.br
CLASSAPP_GRAPHQL_URL=https://web.classapp.com.br/graphql
CLASSAPP_LOCALE=pt

# Geral
TZ=America/Sao_Paulo
NOVNC_PORT=6080
DATA_DIR=/data
SYNC_CONCURRENCY=6
# Dias antes do último sync em que as mensagens são reexaminadas, para pegar
# fotos adicionadas depois em mensagens antigas (padrão: 30).
SYNC_LOOKBACK_DAYS=30
